{% comment %} Custom Banner (no Dawn section reuse) {% endcomment %}
<section class="ce-banner">
  <div class="ce-banner__inner">
    <div class="ce-banner__art">
      {%- if section.settings.banner_image != blank -%}
        {{ section.settings.banner_image | image_url: width: 1600 | image_tag: class: 'ce-banner__img', loading: 'eager' }}
      {%- endif -%}
      <span class="ce-banner__label-left">{{ section.settings.left_label }}</span>
      <span class="ce-banner__label-right">{{ section.settings.right_label }}</span>
    </div>

    <div class="ce-banner__content">
      <p class="ce-banner__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="ce-banner__heading">{{ section.settings.heading }}</h1>
      <p class="ce-banner__sub">{{ section.settings.subtext }}</p>
      {%- if section.settings.btn_label != blank -%}
        <a class="ce-banner__btn" href="{{ section.settings.btn_link }}">
          {{ section.settings.btn_label }} →
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
.ce-banner{position:relative;overflow:hidden;padding:clamp(24px,5vw,56px) 0;background:var(--color-background);}
.ce-banner__inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.2fr .8fr;gap:32px;align-items:center;padding:0 16px;}
.ce-banner__art{position:relative;}
.ce-banner__img{width:100%;height:auto;display:block;border:1px solid rgba(0,0,0,.06);}
.ce-banner__label-left,.ce-banner__label-right{position:absolute;font-size:12px;letter-spacing:.2em;writing-mode:vertical-rl;text-orientation:mixed;background:#fff;border:1px solid #eee;padding:8px 6px;}
.ce-banner__label-left{left:-12px;top:16px;}
.ce-banner__label-right{right:-12px;bottom:16px;}
.ce-banner__content{display:flex;flex-direction:column;gap:12px;}
.ce-banner__eyebrow{font-weight:600;letter-spacing:.08em;text-transform:uppercase;}
.ce-banner__heading{font-size:clamp(28px,4.2vw,56px);line-height:1.05;margin:0;}
.ce-banner__sub{opacity:.8;max-width:46ch;}
.ce-banner__btn{display:inline-block;border:1px solid currentColor;padding:12px 18px;text-decoration:none;transition:transform .25s ease;}
.ce-banner__btn:focus,.ce-banner__btn:hover{transform:translateY(-2px);}
@media(max-width: 900px){.ce-banner__inner{grid-template-columns:1fr;}}
{% endstyle %}

{% schema %}
{
  "name": "Custom Banner (EcomExperts)",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Banner artwork" },
    { "type": "text", "id": "left_label", "label": "Left vertical label", "default": "TISSO VISION" },
    { "type": "text", "id": "right_label", "label": "Right label", "default": "CHOOSE GIFT →" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tisso Vision" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "subtext", "label": "Sub text", "default": "Discover our curated holiday edit…" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Custom Banner (EcomExperts)" }]
}
{% endschema %}